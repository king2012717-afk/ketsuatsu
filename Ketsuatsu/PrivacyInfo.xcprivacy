<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  ATT の許可が得られた場合はパーソナライズ広告が配信されるため「トラッキングあり」。
	  トラッキング先のドメインは Google Mobile Ads SDK 側のマニフェストで宣言されるので、
	  アプリ側は空のままでよい（アプリ自身は外部へ通信しない）。
	-->
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  このアプリ自身が収集するデータはない（記録は端末内と、ユーザーが許可した場合のヘルスケアのみ）。
	  広告（Google Mobile Ads SDK）が収集するデータは SDK 側のプライバシーマニフェストで宣言される。
	  App Store Connect の「App のプライバシー」では、SDK 側のぶんも含めて申告すること。
	  → Store/store-listing.md の「App のプライバシー」を参照
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- 利用理由の申告が必要な API -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- 目標値・判定基準・リマインダーの設定を端末内に保存するために UserDefaults を使用 -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
