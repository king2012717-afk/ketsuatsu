<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  アプリ自身のコードはトラッキングをしないので false。トラッキング先のドメイン（NSPrivacyTrackingDomains）は書かない。
	  - true にすると、ドメインを 1 つ以上書かないと App Store の検証で ITMS-91064（Invalid tracking information）になる
	    （1.3 (2) で発生）。広告 SDK（LevelPlay／Unity Ads／Ad Quality）のマニフェストも、トラッキング先のドメインを宣言していない
	  - ATT（トラッキングの確認）は広告 SDK のために出す。App Store Connect の「App のプライバシー」では、
	    ATT を出すアプリは広告に使うデータを「トラッキングに使用：はい」と答える必要がある（1.3 (1) で指摘）。
	    こちらは Store/store-listing.md の表のとおり
	-->
	<key>NSPrivacyTracking</key>
	<false/>

	<!--
	  血圧・脈拍・メモ・写真などの記録は端末内（と、ユーザーが許可した場合のヘルスケア）にのみ保存し、外部へ送らない。
	  以下は SDK が扱う情報。LevelPlay 9.6.0 の SDK マニフェストは収集データを宣言していないため、アプリ側で宣言する。
	  - 広告: Unity LevelPlay（ironSource Ads／Unity Ads）… 目的「サードパーティ広告」
	  - アクセス解析: Firebase Analytics（FirebaseAnalyticsCore。IDFA は扱わない）… 目的「アナリティクス」
	    送るのは操作のイベントのみで、健康情報・個人情報は含めない（FIREBASE_ANALYTICS.md）。
	  App Store Connect の「App のプライバシー」も同じ内容で回答する（Store/store-listing.md）。
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAdvertisingData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<!-- Firebase Analytics が IP アドレスから国・地域を推定する -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>

	<!-- 利用理由の申告が必要な API -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- 目標値・判定基準・リマインダー・広告の同意の設定と、分析イベントの送信済みフラグ・記録件数を
			     端末内に保存するために UserDefaults を使用（アプリ内でのみ利用） -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
